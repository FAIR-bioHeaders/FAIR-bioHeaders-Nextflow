config {
    // Tests of the nf-core-style modules in modules/nf-core/fairbioheaders.
    // Run from the repository root: nf-test test --profile docker
    testsDir = "modules"
    workDir = System.getenv("NFT_WORKDIR") ?: ".nf-test"
    configFile = "tests/config/nf-test.config"
    profile = ""

    plugins {
        load "nft-utils@1.2.1"
    }
}

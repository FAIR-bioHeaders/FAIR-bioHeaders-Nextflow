nextflow.enable.dsl = 2
params {
    metadata = null
    source = null
    payload = null
    expected_payload = null
    family = null
    formats = 'json,yaml'
    kind = 'fasta'
    parent = null
    outdir = 'family-results'
}
outputDir = params.outdir
workflow.output.mode = 'copy'
process {
    executor = 'local'
    cpus = 1
    memory = '1 GB'
    ext.prefix = { meta.id }
}
// Native-host acceptance intentionally does not enable conda or Docker. Their
// existing immutable pins remain the separately documented 0.9.0 baseline.
docker.enabled = false
conda.enabled = false
